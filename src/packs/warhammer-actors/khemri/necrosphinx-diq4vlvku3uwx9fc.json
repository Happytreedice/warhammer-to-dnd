      "system": {
        "description": {
          "value": "<p><strong>Tomb Kings of Khemri Armour.</strong> Tomb Kings of Khemri Armour carries the hard doctrine of the Tomb Kings of Khemri: a practical piece of war-gear made to keep its bearer standing when the press of shields turns desperate.</p><p><strong>Mechanics.</strong> Armor Class 15; Dexterity cap 2; Strength requirement 0.</p><blockquote><p>\"Victory belongs to the hand that does not tremble at dusk.\"<br><em>- Old World armorer's maxim</em></p></blockquote>",
          "chat": "Armor Class 15; Dexterity cap 2; Strength requirement 0."
        },
        "source": {
          "custom": "",
